# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
backend/.venv/

# Packaging
*.egg-info/

# Node
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
eufy-bridge/node_modules/

# Local configuration
.env
.env.*
!.env.example

# OAuth token cache (contains refresh tokens)
*.msal_token_cache.json
.msal_token_cache*

# eufy-security-client persisted session (cloud tokens, push credentials — see
# docs/eufy-sdk-integration.md "Session persistence"). Reusing it skips a fresh
# cloud login, which matters for staying under eufy's abuse-cooldown threshold.
# The literal filename varies with whatever MISSION_CONTROL_EUFY_SESSION_FILE
# resolves to on a given host (the code default is .eufy_persistent.json, but
# e.g. the 2026-09-11 hardware bring-up landed on backend/persistent.json) --
# ignore both spellings rather than assume the default is what's on disk.
.eufy_persistent.json
*.eufy_persistent.json
persistent.json
backend/persistent.json

# @mega-yfue/eufy-sdk's own persisted session (docs/eufy-sdk-integration.md
# §18-§20) -- a second, unrelated persistence format, never shared with the
# eufy-security-client session file above.
.eufy_mega_persistent.json
*.eufy_mega_persistent.json

# Eufy clip gallery: short-lived decrypted clip cache
# (MISSION_CONTROL_EUFY_CLIP_CACHE_DIR) — evicted on a TTL by the bridge
# itself. This is the one place this feature writes decrypted media to disk
# on a short-lived basis (docs/eufy-sdk-integration.md).
.eufy_clip_cache/
backend/.eufy_clip_cache/

# Eufy clip gallery: the SEPARATE durable gallery cache
# (MISSION_CONTROL_EUFY_GALLERY_CACHE_DIR, app/eufy/cache.py) — the last few
# clips' metadata/thumbnail/video, deliberately persisted across restarts so
# a restart shows the same gallery instead of an empty one. Local device
# state, never committed.
.eufy_gallery_cache/
backend/.eufy_gallery_cache/

# Voice debug audio captures (MISSION_CONTROL_VOICE_DEBUG_CAPTURE_DIR)
backend/voice-captures/
voice-captures/

# Household lists store (MISSION_CONTROL_LISTS_FILE) — durable app data, per install
backend/lists.json
lists.json
*.lists.json

# Privacy-mode state (MISSION_CONTROL_PRIVACY_STATE_FILE) — persisted so a
# power-cycle does not clear the lock
backend/privacy.json
privacy.json
*.privacy.json

# Non-primary Outlook calendar opt-ins (MISSION_CONTROL_CALENDAR_SECONDARY_STATE_FILE)
backend/secondary_calendars.json
secondary_calendars.json
*.secondary_calendars.json

# Headless uvicorn output when the backend is run detached (redirected
# stdout/stderr), and dev.ps1's own mirrored copy (+ one rotated .previous)
# of the same -- see backend/dev.ps1.
backend/uvicorn.out.log
backend/uvicorn.out.log.previous
backend/uvicorn.err.log

# Local STT benchmark samples + downloaded model caches (provisioned per install)
backend/voice-samples/
voice-samples/
backend/models/stt/
*.stt-bench.json

# Ad-hoc local run logs (e.g. a backgrounded `uvicorn` redirected here for
# manual/live testing) — never durable app data, never committed
backend/.run/

# Local-only archive of live diagnostic captures (pcaps, phone logcat, bridge
# debug logs) from one-off hardware investigations — kept on disk for future
# reference, never committed (can contain LAN/device identifiers).
backend/.eufy-investigation/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.claude/worktrees/
.DS_Store
Thumbs.db
