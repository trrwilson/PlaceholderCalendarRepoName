# Mission Control backend configuration.
# Copy to `.env` (git-ignored) and fill in real values.
# Every variable uses the MISSION_CONTROL_ prefix.

# Which calendar provider to serve:
#   mock              in-memory demo data (default)
#   graph             Azure AD tenant mailboxes, app-only  (see below)
#   outlook_personal  a personal outlook.com / hotmail.com account, delegated sign-in
MISSION_CONTROL_CALENDAR_PROVIDER=mock

# --- Microsoft Graph (Outlook) provider -------------------------------------
#
# Azure app registration prerequisites (one-time, done by a tenant admin):
#   1. Register an application in Entra ID (Azure AD).
#   2. Add the APPLICATION permissions Microsoft Graph > Calendars.Read and
#      MailboxSettings.Read (app-only, NOT delegated) and grant admin consent for
#      the tenant. (MailboxSettings.Read lets the dashboard read each mailbox's
#      Outlook category colours; without it categories show a neutral marker.)
#   3. Create a client secret and copy its value immediately.
# The app then reads each configured mailbox's calendar without a signed-in user.

# Directory (tenant) ID of the Azure AD tenant.
MISSION_CONTROL_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the registered app.
MISSION_CONTROL_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret value for the registered app.
MISSION_CONTROL_GRAPH_CLIENT_SECRET=your-client-secret-value

# Comma-separated mailboxes (UPN / email) to surface; each becomes one calendar.
MISSION_CONTROL_GRAPH_CALENDAR_USERS=alex@example.com,jordan@example.com

# Optional: comma-separated CalendarColor names (coral, ocean, gold, fern, violet),
# one per user above. Omit to round-robin through the palette automatically.
MISSION_CONTROL_GRAPH_CALENDAR_COLORS=ocean,gold

# --- Personal Outlook / Hotmail account (CALENDAR_PROVIDER=outlook_personal) -----
#
# App-only access does NOT work for personal Microsoft accounts, so a household
# member signs in once and the refresh token is cached to disk.
#
# One-time app registration (no tenant admin needed):
#   1. https://portal.azure.com > App registrations > New registration.
#      Supported account types: "Personal Microsoft accounts only".
#      No redirect URI.
#   2. Authentication > Advanced settings > "Allow public client flows" = Yes.
#   3. API permissions > Microsoft Graph > Delegated > Calendars.Read  (no admin
#      consent needed for a personal account; you consent during sign-in).
#   4. Copy the Application (client) ID below. No client secret is used.
#
# Then sign in once, either:
#   - on the kiosk: the dashboard shows a "Calendar sign-in" prompt with a QR
#     code and a device code; scan it with a phone and approve access; or
#   - headless, from the backend/ directory:
#       python -m app.auth login     # prints a code for microsoft.com/devicelogin
#       python -m app.auth status
#
# Reuses MISSION_CONTROL_GRAPH_CLIENT_ID (the personal-accounts app's client ID)
# and MISSION_CONTROL_GRAPH_CALENDAR_COLORS[0] for the calendar's identity color.

# The kiosk sign-in endpoints (/api/calendar/auth*) reveal the account and can
# sign out, so by default they only answer loopback / LAN requests. Set true only
# if the kiosk frontend is served from a non-private address.
MISSION_CONTROL_ALLOW_REMOTE_AUTH=false

# Authority endpoint. Keep the default for a personal account; use
# https://login.microsoftonline.com/common to also allow work/school accounts.
MISSION_CONTROL_GRAPH_AUTHORITY=https://login.microsoftonline.com/consumers

# Where the signed-in refresh token is cached (git-ignored). Relative to the
# process working directory (backend/ when you run uvicorn from there).
MISSION_CONTROL_GRAPH_TOKEN_CACHE=.msal_token_cache.json

# --- Voice assistant -------------------------------------------------------
#
# Off by default. The token endpoint returns 409 until this is true.
MISSION_CONTROL_VOICE_ENABLED=false

# Which conversational voice provider handles a turn. This is a bake-off (see
# docs/voice-provider-bakeoff-plan.md). All five are implemented:
#   gemini                       browser-direct Gemini Live (verified end to end)
#   azure_openai_realtime        via WS /api/voice/live relay
#   azure_openai_realtime_mini   via the relay
#   azure_voice_live             via the relay
#   local                        on-device STT + intents (experimental; see below)
# Each 409s until its own credential block is filled in. Wake-word selection is
# separate from this, and so is microphone capture — the gain, rates and echo
# cancellation below are pipeline-wide, not per provider (docs/audio-pipeline.md).
MISSION_CONTROL_VOICE_PROVIDER=gemini

# THE microphone level knob. A plain amplitude gain the kiosk browser applies to
# captured audio once, before wake-word detection and before anything is streamed
# to a voice provider. Decibels, converted to a linear multiplier as 10^(dB/20);
# 0 disables the stage, which is the default: the kiosk captures through a
# hardware microphone path with adequate level, so no software boost is applied
# unless an install needs one. Range -30..40; matches the app/config.py default.
#
# Nothing else in the app changes capture level: browser auto-gain-control is
# explicitly off so it cannot fight this, and the client's end-of-speech
# thresholds are normalised back to a fixed reference gain so raising this does
# not silently re-tune them. Full picture: docs/audio-pipeline.md.
#
# Tune against the throttled `[voice] mic input level` console line: aim for a
# speech peak of ~0.3-0.7 with clip% at 0. Independent of the microphone hardware.
MISSION_CONTROL_MIC_INPUT_GAIN_DB=0

# --- Voice assistant: Gemini Live (native audio) ---------------------------
#
# The kiosk browser opens the Gemini Live session itself, using a short-lived
# ephemeral token minted by POST /api/voice/token. This API key never leaves the
# backend. Get one from Google AI Studio.
#
# Provisioned in the environment as GEMINI_API_KEY_MISSION_CONTROL (note: no
# MISSION_CONTROL_ prefix); MISSION_CONTROL_GEMINI_API_KEY is also accepted.
GEMINI_API_KEY_MISSION_CONTROL=your-gemini-api-key

# Live model id. `gemini-3.1-flash-live-preview` is Google's recommended Live
# model; the `...-native-audio-preview-...` ids are deprecated and slated for
# shutdown, and were measurably slower (~5.7 s from end-of-speech to the first
# transcript, reply audio generated at ~0.46x real time).
MISSION_CONTROL_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# API version used to mint the token AND (echoed back to the kiosk) to open the
# Live socket. The two MUST match. v1beta for gemini-3.x; v1alpha only with a
# `...-native-audio-preview-...` model.
MISSION_CONTROL_GEMINI_LIVE_API_VERSION=v1beta

# End-of-speech for Gemini (see docs/voice-provider-bakeoff-plan.md ->
# "End-of-speech ownership"). false (default) = `endpointing = "hybrid"`: the
# service runs streaming voice-activity detection (which keeps ASR running *while*
# you speak) and the kiosk sends `audioStreamEnd` the moment its own RMS detector
# hears the pause. true = `endpointing = "client"`: fully manual activityStart/
# activityEnd with the service VAD off — deterministic, but the service then only
# transcribes after the turn ends (the 2026-09 silent-turn escape hatch).
MISSION_CONTROL_VOICE_MANUAL_ACTIVITY=false
# Service-VAD endpointing, used only when MANUAL_ACTIVITY is false.
MISSION_CONTROL_VOICE_PREFIX_PADDING_MS=100
MISSION_CONTROL_VOICE_SILENCE_DURATION_MS=250

# Prebuilt Gemini voice (Zephyr, Puck, Charon, Kore, Aoede, ...). English is
# pinned via the system prompt; leave GEMINI_LANGUAGE_CODE unset for native audio.
MISSION_CONTROL_GEMINI_VOICE=Zephyr
# MISSION_CONTROL_GEMINI_LANGUAGE_CODE=en-US

# --- Voice assistant: Azure contestants (bake-off) -------------------------
# Both Azure providers go through the backend relay (WS /api/voice/live) — see
# docs/voice-provider-bakeoff-plan.md. UNVERIFIED against live Azure; confirm
# deployment names / the transcribe deployment against your resources.
#
# Azure OpenAI Realtime — the GA /openai/v1 surface (OpenAI-parity: no
# api-version, model=<deployment> in the URL). `gpt-realtime-2.1` and `...-mini`
# are two contestants off one resource.
# MISSION_CONTROL_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# The key is read from MISSION_CONTROL_AZURE_OPENAI_API_KEY, else the shared
# Foundry key FOUNDRY_API_KEY_MC_EASTUS2 (see app/config.py aliases).
# MISSION_CONTROL_AZURE_OPENAI_API_KEY=your-azure-openai-key
MISSION_CONTROL_AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1
MISSION_CONTROL_AZURE_OPENAI_REALTIME_MINI_DEPLOYMENT=gpt-realtime-2.1-mini
MISSION_CONTROL_AZURE_OPENAI_REALTIME_VOICE=marin
# End-of-speech: client | hybrid | provider (docs/voice-provider-bakeoff-plan.md
# -> "End-of-speech ownership"). hybrid (default) = semantic_vad with
# create_response off (streaming ASR + the kiosk's speech-stopped endpoint +
# mic-RMS backstop); client = turn_detection null (kiosk mic-RMS only);
# provider = semantic_vad with create_response on (the model answers on its own
# endpoint, kiosk sends no finalise).
MISSION_CONTROL_AZURE_OPENAI_REALTIME_ENDPOINTING=hybrid
# Deployment name of a transcribe model for the user's speech transcript.
# Default `gpt-4o-transcribe`; blank turns the transcript off. (In hybrid/client
# end-of-speech it transcribes after you stop talking, not word by word.)
MISSION_CONTROL_AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=gpt-4o-transcribe
#
# Azure Voice Live — a separate product (noise reduction, echo cancellation,
# Azure semantic VAD, HD voices). Still uses api-version + the flat session shape.
# MISSION_CONTROL_AZURE_VOICE_LIVE_ENDPOINT=https://your-resource.services.ai.azure.com
# Key: MISSION_CONTROL_AZURE_VOICE_LIVE_API_KEY, else FOUNDRY_API_KEY_MC_EASTUS2.
MISSION_CONTROL_AZURE_VOICE_LIVE_API_VERSION=2026-07-15
MISSION_CONTROL_AZURE_VOICE_LIVE_MODEL=gpt-realtime
MISSION_CONTROL_AZURE_VOICE_LIVE_VOICE=en-GB-SoniaNeural
MISSION_CONTROL_AZURE_VOICE_LIVE_VOICE_TYPE=azure-standard
MISSION_CONTROL_AZURE_VOICE_LIVE_TRANSCRIBE_MODEL=whisper-1
# End-of-speech: hybrid | provider only (azure_semantic_vad must stay on for the
# server-side echo canceller, so `client` is unavailable here). hybrid (default)
# = create_response off, kiosk endpoints on speech-stopped; provider =
# create_response on, Voice Live answers on its own VAD endpoint.
MISSION_CONTROL_AZURE_VOICE_LIVE_ENDPOINTING=hybrid
#
# How long a relay ticket (in the grant, spent to open WS /api/voice/live) lasts.
MISSION_CONTROL_VOICE_RELAY_TICKET_TTL_SECONDS=120

# --- Voice token caching (see docs/voice-token-caching-notes.md) ------------
# The backend caches the minted ephemeral token and the calendar snapshot its
# system prompt is built from, so back-to-back kiosk turns skip both the Graph
# request and Google's auth_tokens.create.
#
# Google-side token envelope: expire_time / new_session_expire_time. Only an
# outer bound — the backend stops re-serving a cached token long before this.
# The Gemini API hard-caps it under 20 hours.
MISSION_CONTROL_VOICE_TOKEN_TTL_SECONDS=14400
# Longest a cached token is re-served regardless of the calendar. Real
# invalidation is usually sooner: the next event start/end or local midnight, so
# a stale "It is now ..." stamp can't make "what's next" name a finished event.
MISSION_CONTROL_VOICE_TOKEN_MAX_STALE_SECONDS=1800
# How long the calendar snapshot behind the voice prompt is reused.
MISSION_CONTROL_VOICE_PROMPT_CACHE_TTL_SECONDS=120
# Days of the household schedule (title / time / location, one line per day)
# baked into the voice system instruction so a loose reference like "that doctor
# appointment in Bellevue later this month" resolves without a tool call. Also
# the window the Local / Hybrid pipeline resolves entities against per turn.
MISSION_CONTROL_VOICE_CONTEXT_DAYS=30
# Uses per minted token. 0 = unlimited within the ttl window (one token backs
# many turns). A small positive number tightens a leaked-token blast radius.
MISSION_CONTROL_VOICE_TOKEN_USES=0

# --- Wake word -------------------------------------------------------------
#
# When enabled, the kiosk listens for the wake phrase and opens a normal voice
# turn when it hears it — no touch required.
#
# Two detection back ends (a bake-off, orthogonal to VOICE_PROVIDER; switch at
# runtime from Settings). `openwakeword` (default): local ONNX in the kiosk
# browser — idle listening never leaves the browser, only the turn after the
# phrase reaches the voice provider. `azure`: the kiosk streams mic audio to the
# backend, which spots an Azure custom-keyword `.table` offline with the native
# Speech SDK (no key, no network) — the audio does reach the backend
# (localhost / LAN). Needs `pip install -e '.[azure-wake]'`.
MISSION_CONTROL_WAKE_WORD_PROVIDER=openwakeword

# Backend path to the Azure custom-keyword `.table` (Speech Studio export), read
# only by the `azure` provider. Relative to the backend working directory.
MISSION_CONTROL_WAKE_WORD_AZURE_MODEL_PATH=../frontend/public/models/wake/azure_mission_control_basic_med.table

# The on-device Invoke gate is an ADDITIVE first stage in front of whichever
# provider above is selected (not a provider itself). The `invoke-gate` daemon
# on the Harman Kardon Invoke (ReInvoke2026 `wakeword/`) runs a loose KWS + an
# audio egress gate; the selected detector (openWakeWord / Azure) then re-checks
# the gated audio, and an activation needs BOTH. The gated audio reaches the
# kiosk over VB-CABLE unchanged; the backend only bridges the daemon's LAN
# control socket (`WS /api/voice/wake/invoke`). Empty host => feature hidden.
MISSION_CONTROL_WAKE_WORD_INVOKE_GATE_HOST=
MISSION_CONTROL_WAKE_WORD_INVOKE_GATE_AUDIO_PORT=5004
MISSION_CONTROL_WAKE_WORD_INVOKE_GATE_CONTROL_PORT=5005
# Turn the additive gate on. OFF by default. On => the kiosk opens the bridge,
# tells the daemon to gate its egress, and only activates when the gate window
# AND the selected detector both accept. Toggle at runtime from Settings
# (PUT /api/voice/wake-config {"invoke_gate_enabled": true}).
MISSION_CONTROL_WAKE_WORD_INVOKE_GATE_ENABLED=false

# Wi-Fi speaker OUTPUT to the Invoke (the mirror of the mic path). When the
# kiosk's Settings -> Speaker output is set to "Invoke", the browser streams its
# whole output bus (assistant replies, listening cue, timer chime) to
# `WS /api/voice/speaker`; the backend widens it and forwards it over TCP to the
# `invoke_speaker_daemon.sh` receiver on the device (ReInvoke2026 `output/`),
# which plays it out the speakers through the stock `music` ALSA route. No
# OS-wide virtual audio device, no separate feeder process, device receiver
# unchanged. Empty host => the picker offers only "This screen", then falls back
# to MISSION_CONTROL_WAKE_WORD_INVOKE_GATE_HOST so one value configures both
# directions. DRIFT_PPM is an open-loop single-sample slip (0 = off; positive =>
# the Invoke DAC runs fast); feed-forward the ppm the ReInvoke2026 mic feeder
# prints.
MISSION_CONTROL_INVOKE_SPEAKER_HOST=
MISSION_CONTROL_INVOKE_SPEAKER_AUDIO_PORT=5006
MISSION_CONTROL_INVOKE_SPEAKER_DRIFT_PPM=0
#
# Off by default, and it does nothing until BOTH MISSION_CONTROL_VOICE_ENABLED
# and this are true AND a trained model asset is served at the path below.
# Training / obtaining the "Mission Control" model: see
# docs/wake-word-model-training.md. Push-to-talk (the Ask button) is unaffected
# by any of this and always remains available.
MISSION_CONTROL_WAKE_WORD_ENABLED=false

# The phrase the model is trained for (informational; changing it retrains
# nothing). Shown in Settings.
MISSION_CONTROL_WAKE_WORD_PHRASE=Mission Control

# openWakeWord score 0..1 to trigger on. Raise toward 0.7-0.8 if the room causes
# false activations; lower toward 0.3-0.4 if real utterances are missed.
# Scores are level-dependent, so re-check this after changing MIC_INPUT_GAIN_DB
# (watch the throttled `[wake] peak score` console line).
MISSION_CONTROL_WAKE_WORD_THRESHOLD=0.3

# Suppress further detections for this many ms after one fires.
MISSION_CONTROL_WAKE_WORD_COOLDOWN_MS=2000

# Where the frontend serves the model assets from. The trained wake model lives
# at MODEL_PATH; the shared openWakeWord feature models (melspectrogram.onnx,
# embedding_model.onnx) load from MODELS_BASE_URL. Put the files under
# frontend/public/models/wake/ (git-ignored — provisioned per install).
MISSION_CONTROL_WAKE_WORD_MODEL_PATH=/models/wake/mission_control.onnx
MISSION_CONTROL_WAKE_WORD_MODELS_BASE_URL=/models/wake

# --- Voice debug audio capture -------------------------------------------------
#
# The kiosk retains the last N activations' provider-input audio in the browser
# (window.__voiceDebug) and, when this is on, POSTs each finished capture to the
# backend, which writes a headered WAV + a .json sidecar here — a faithful
# recording of exactly what reached the speech provider, for playback. On by
# default; LAN-only like every voice route. Relative paths are under the backend
# working directory (next to the MSAL cache); an absolute path works too.
MISSION_CONTROL_VOICE_DEBUG_CAPTURE_ENABLED=true
MISSION_CONTROL_VOICE_DEBUG_CAPTURE_DIR=voice-captures
# Headered WAV + sidecar pairs kept on disk; oldest pruned as new ones arrive.
# 0 keeps everything. The in-browser ring size is separate (localStorage
# 'voice.debug.count', also 10).
MISSION_CONTROL_VOICE_DEBUG_CAPTURE_KEEP=10

# --- Voice: Local / Hybrid pipeline (experimental) ---------------------------
#
# A fifth voice "provider" — on-device speech recognition + intent/entity
# interpretation, with cloud escalation only for requests that need general
# reasoning. Select it with MISSION_CONTROL_VOICE_PROVIDER=local (or switch at
# runtime in Settings). Nothing here affects the Gemini / Azure paths. Full
# design: docs/local-voice-plan.md; STT evidence: docs/local-stt-evaluation.md.

# STT engine. "auto" = the first installed of faster_whisper / sherpa_onnx, else
# a dependency-free scripted recogniser that only serves the text-bypass path.
#   pip install faster-whisper      (recommended; pulls ctranslate2)
#   pip install sherpa-onnx         (optional; true streaming, needs a model dir)
MISSION_CONTROL_LOCAL_STT_ENGINE=auto

# faster-whisper: a model id. Measured on this box's CPU (int8), end-of-speech ->
# final transcript: tiny.en ~160 ms, base.en ~280 ms, small.en ~870 ms, at
# near-identical accuracy on short commands. base.en is the default.
# sherpa-onnx: an absolute path (or one under LOCAL_STT_MODELS_DIR) to a
# streaming-zipformer model directory (encoder/decoder/joiner .onnx + tokens.txt).
MISSION_CONTROL_LOCAL_STT_MODEL=base.en

# "auto" (=cpu; a discrete GPU is an opt-in accelerator, never required) / cpu /
# cuda. cuda needs the CUDA 12 + cuDNN 9 runtime on PATH; a load failure falls
# back to CPU.
MISSION_CONTROL_LOCAL_STT_DEVICE=auto
# faster-whisper compute type; "auto" -> int8 on CPU, float16 on CUDA.
MISSION_CONTROL_LOCAL_STT_COMPUTE_TYPE=auto
MISSION_CONTROL_LOCAL_STT_BEAM_SIZE=1
# Where engines cache downloaded model files. Blank = the engine default (the
# Hugging Face cache for faster-whisper). Model binaries are never committed.
MISSION_CONTROL_LOCAL_STT_MODELS_DIR=

# Interpretation thresholds. Below _INTENT_ the request escalates / asks; a
# *mutating* request below _MUTATION_ is never executed on a guess.
MISSION_CONTROL_LOCAL_INTENT_CONFIDENCE_THRESHOLD=0.55
MISSION_CONTROL_LOCAL_MUTATION_CONFIDENCE_THRESHOLD=0.8
MISSION_CONTROL_LOCAL_ENTITY_CONFIDENCE_THRESHOLD=0.55

# When false, a request the local layer can't handle is a plain "can't do that"
# instead of being handed to a cloud model. (The cloud text call itself is a
# stub / extension point in this experiment — see docs/local-voice-plan.md.)
MISSION_CONTROL_LOCAL_CLOUD_ESCALATION_ENABLED=true

# Casual -> real name hints for entity resolution, e.g. "mom=Sarah,dad=Travis".
# Only a hint: an alias still has to fuzzy-match a real household calendar.
MISSION_CONTROL_LOCAL_PERSON_ALIASES=

# Emit the full interpretation trace (transcript, intent scores, entity
# candidates, timings) on the diagnostic channel and POST .../local/interpret.
MISSION_CONTROL_LOCAL_VOICE_DIAGNOSTICS=true

# --- Timers ----------------------------------------------------------------
#
# Timers are backend-owned and in-memory (a restart clears any active timer).
# One active timer at a time. No feature flag — timers are core, not opt-in.

# The product ceiling for a timer / alarm lookahead, in seconds (default 6h).
# Enforced by the Pydantic model, the voice tool check, and the touch dial.
MISSION_CONTROL_TIMER_MAX_SECONDS=21600

# How long the expiry chime loops before it stops on its own. The visual
# "Timer finished" state stays until a person dismisses it regardless.
MISSION_CONTROL_TIMER_ALARM_MAX_RING_SECONDS=300

# --- Lists (grocery, for now) --------------------------------------------
#
# Unlike timers, a household list is durable — persisted to this one JSON file
# (relative -> the backend working dir, alongside the MSAL cache; git-ignored)
# and reloaded at startup. Same "one file, no datastore" class as the token
# cache. Blank = in-memory only (lost on restart). No feature flag — core.
MISSION_CONTROL_LISTS_FILE=lists.json

# How many distinct past item names the touch quick-add grid remembers.
MISSION_CONTROL_LISTS_RECENT_ITEMS_MAX=20

# --- Privacy mode --------------------------------------------------------
#
# A houseguest-facing "redact the specifics + read-only" state. Entered from the
# kiosk (long-press the logo, Settings, or ask the assistant); left only by
# entering this PIN on the on-screen keypad. Backend config only — there is no
# in-app way to set it. Blank disables the whole feature (the entry affordances
# are hidden and POST /api/privacy/lock 409s) so nobody can be locked out.
#
# MVP: exactly four digits, entered on a fixed keypad (7-8-9 / 4-5-6 / 1-2-3 / 0).
# The default 8426 traces up-left-down-right on that layout.
MISSION_CONTROL_PRIVACY_MODE_PIN=8426

# Persisted so a power-cycle does not defeat the lock. Relative -> backend
# working dir (git-ignored). Blank = in-memory only.
MISSION_CONTROL_PRIVACY_STATE_FILE=privacy.json

# Wrong-PIN attempts before the keypad locks for a cooldown, and the base
# cooldown in seconds (doubles on each further lockout, capped at 1h). Counters
# are process memory only — a restart clears them.
MISSION_CONTROL_PRIVACY_UNLOCK_MAX_ATTEMPTS=5
MISSION_CONTROL_PRIVACY_UNLOCK_COOLDOWN_SECONDS=60

# A just-entered privacy mode can be turned off with no PIN for this long — an
# accidental / prank-entry guard.
MISSION_CONTROL_PRIVACY_UNDO_GRACE_SECONDS=8
