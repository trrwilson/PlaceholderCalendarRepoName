# Mission Control backend configuration.
# Copy to `.env` (git-ignored) and fill in real values.
# Every variable uses the MISSION_CONTROL_ prefix.

# Which calendar provider to serve: "mock" (default, in-memory demo data) or "graph".
MISSION_CONTROL_CALENDAR_PROVIDER=mock

# --- Microsoft Graph (Outlook) provider -------------------------------------
#
# Azure app registration prerequisites (one-time, done by a tenant admin):
#   1. Register an application in Entra ID (Azure AD).
#   2. Add the APPLICATION permission Microsoft Graph > Calendars.Read
#      (app-only, NOT delegated) and grant admin consent for the tenant.
#   3. Create a client secret and copy its value immediately.
# The app then reads each configured mailbox's calendar without a signed-in user.

# Directory (tenant) ID of the Azure AD tenant.
MISSION_CONTROL_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the registered app.
MISSION_CONTROL_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret value for the registered app.
MISSION_CONTROL_GRAPH_CLIENT_SECRET=your-client-secret-value

# Comma-separated mailboxes (UPN / email) to surface; each becomes one calendar.
MISSION_CONTROL_GRAPH_CALENDAR_USERS=alex@example.com,jordan@example.com

# Optional: comma-separated CalendarColor names (coral, ocean, gold, fern, violet),
# one per user above. Omit to round-robin through the palette automatically.
MISSION_CONTROL_GRAPH_CALENDAR_COLORS=ocean,gold
